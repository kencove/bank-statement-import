<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="PlaidLinkTemplate">
        <div class="o_plaid_link_container p-4">
            <div class="plaid-loading text-center">
                <i class="fa fa-spinner fa-spin fa-3x mb-3" />
                <p class="text-muted">Loading Plaid Link...</p>
            </div>
            <div class="plaid-error alert alert-danger" style="display: none;">
                <i class="fa fa-exclamation-triangle me-2" />
                <span class="error-message" />
                <button
                    class="btn btn-primary btn-sm ms-3 retry-btn"
                    onclick="window.location.reload()"
                >
                    Retry
                </button>
            </div>
        </div>
    </t>

</templates>
